{
  "manifest_version": 3,
  "name": "Slither.io Zoom",
  "version": "1.0.2",
  "description": "Slither.io oyununda fare tekerleğiyle yakınlaş ve uzaklaş. 0 tuşuyla normal görünüme dön.",
  "content_scripts": [
    {
      "matches": [
        "*://slither.com/io*",
        "*://www.slither.com/io*",
        "*://slither.io/*",
        "*://www.slither.io/*"
      ],
      "js": [
        "zoom.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Slither.io Zoom",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  }
}
